# The small notice after a capture. $file: the saved file's full path;
# $folder: a folder.

toast-copied-and-saved = Copied, and saved to { $file }
toast-saved = Saved to { $file }
toast-copied = Copied to the clipboard
toast-hint = Click to open it, right-click to open its folder
toast-without-drawing = Without the drawing

## When a capture doesn't work. $reason: what went wrong, as the system says it.

toast-save-failed = The capture couldn't be saved to { $folder }: { $reason }
toast-copy-failed = The capture couldn't be copied to the clipboard: { $reason }
# Copied, but the file couldn't be saved.
toast-copied-not-saved = Copied to the clipboard, but it couldn't be saved to { $folder }: { $reason }
toast-capture-failed = The screen couldn't be captured: { $reason }
# Overmark couldn't get a picture of the screen without its own windows on it.
toast-capture-no-image = The screen couldn't be captured: Overmark couldn't get a clean picture of it.
toast-open-failed = { $file } couldn't be opened: { $reason }

## After a recording. $file: the video's full path; $reason: what went wrong.

toast-recording-saved = Recording saved to { $file }
toast-recording-failed = The recording couldn't be made: { $reason }
# Record a region (the tray's item or its hotkey) while the drawing layer is open.
toast-record-layer-open = Close the drawing layer to record the screen. To record with your drawing, use Record on its toolbar.
